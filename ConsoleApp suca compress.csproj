<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!--<TargetFramework>net8.0</TargetFramework>
	   -->
	  <TargetFramework>net8.0-windows</TargetFramework>
	  <UseWindowsForms>true</UseWindowsForms>
    <StartupObject>SUCA_Compressor.Program</StartupObject>
    <RootNamespace>ConsoleApp_suca_compress</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Product>Compresor SUCA</Product>
    <AssemblyTitle>Compresor SUCA - render y pesos de imagen</AssemblyTitle>
    <Description>Compresor de imagenes con kernel SUCA: metricas de bpp, ratio e integridad, shell web, ordenes orquestadas y MCP.</Description>
    <Authors>Carlos Ivan CM</Authors>
    <Copyright>Copyright (c) 2026 Carlos Ivan CM</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PdfPig" Version="0.1.12" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.*" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.6" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="legacy/**/*.cs" />
  </ItemGroup>

</Project>
