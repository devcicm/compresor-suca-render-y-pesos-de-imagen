<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!--<TargetFramework>net8.0</TargetFramework>
	   -->
	  <TargetFramework>net8.0-windows</TargetFramework>
	  <UseWindowsForms>true</UseWindowsForms>
    <StartupObject>SUCA_Compressor.Program</StartupObject>
    <RootNamespace>ConsoleApp_suca_compress</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Product>Compresor SUCA</Product>
    <AssemblyTitle>Compresor SUCA - render y pesos de imagen</AssemblyTitle>
    <Description>Compresor de imagenes con kernel SUCA: metricas de bpp, ratio e integridad, shell web, ordenes orquestadas y MCP.</Description>
    <Authors>Carlos Ivan CM</Authors>
    <Copyright>Copyright (c) 2026 Carlos Ivan CM</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PdfPig" Version="0.1.12" />
    <!-- ImageSharp fijado a la linea 2.1.x: Apache-2.0, gratuita y compatible con la
         licencia MIT del proyecto. La 3.x exige licencia comercial de Six Labors en
         compilacion (rompia la CI) y sus versiones flotantes rompian la reproducibilidad.
         SixLabors.ImageSharp.Drawing se elimino: el codigo no lo usa. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="2.1.13" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="legacy/**/*.cs" />
  </ItemGroup>

  <!-- Windows bloquea el .exe mientras la app corre y MSBuild falla con
       MSB3027/MSB3021 tras 10 reintentos. Antes de copiar la salida se cierra la
       instancia en ejecucion. Desactivar con -p:StopRunningApp=false. -->
  <Target Name="StopRunningSuca" BeforeTargets="BeforeBuild" Condition="'$(StopRunningApp)' != 'false'">
    <Exec
      Command="powershell -NoProfile -NonInteractive -Command &quot;$p = Get-Process -Name 'ConsoleApp suca compress' -ErrorAction SilentlyContinue; if ($p) { $p | Stop-Process -Force; Write-Output 'SUCA estaba abierto: se cerro para liberar el .exe.' }; exit 0&quot;"
      ContinueOnError="true"
      StandardOutputImportance="low"
      StandardErrorImportance="low" />
  </Target>

</Project>

